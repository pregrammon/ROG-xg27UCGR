<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="RogControl.Controls.ROGScreenWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid Padding="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Bulb icon | brightness slider | percent -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                Glyph="&#xEA80;"
                FontSize="16"
                Foreground="#F51928"
                VerticalAlignment="Center" />

            <Slider
                x:Name="BrightnessSlider"
                Grid.Column="1"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"
                VerticalAlignment="Center"
                Foreground="#F51928">
                <Slider.Resources>
                    <SolidColorBrush x:Key="SliderThumbBackground" Color="#F51928" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#F51928" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#F51928" />
                </Slider.Resources>
            </Slider>

            <TextBlock
                x:Name="BrightnessPercentText"
                Grid.Column="2"
                Text="--%"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#F51928"
                VerticalAlignment="Center"
                MinWidth="42"
                TextAlignment="Right" />
        </Grid>

        <!-- Dual-mode row: single full-width layer — 4K pinned left,
             1K pinned right, custom fixed-size switch dead center at every
             window width -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <TextBlock
                Text="4K"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#F51928" />

            <!-- Custom switch: fixed 46x22, red outline, red dot slides on
                 click. Fixed size => always perfectly centered. -->
            <Grid x:Name="DualModeSwitchContainer"
                  Width="46" Height="22"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="Transparent"
                  PointerPressed="DualModeSwitchContainer_PointerPressed">
                <Border x:Name="DualModeTrack"
                        CornerRadius="11"
                        BorderBrush="#F51928"
                        BorderThickness="1.5"
                        Background="Transparent" />
                <Ellipse x:Name="DualModeThumb"
                         Width="12" Height="12"
                         Fill="#F51928"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Margin="5,0,0,0" />
            </Grid>

            <TextBlock
                Text="1K"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#F51928" />
        </Grid>

        <!-- Failure message only; hidden while everything works -->
        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Visibility="Collapsed"
            Foreground="Gray"
            FontSize="11"
            TextWrapping="Wrap"
            HorizontalAlignment="Center"
            Margin="0,6,0,0" />
    </Grid>
</UserControl>

<Window
    x:Class="RogControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RogControl.Controls"
    xmlns:local="using:RogControl">

    <!-- Fully transparent window with a red border on the window's outer
         edge. The 6px outer gutters are invisible resize handles. -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="8" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
        </Grid.ColumnDefinitions>

        <!-- Red-bordered card spanning the whole window (no gutter around it);
             interior is 100% transparent. Only the outer DWM edge remains —
             the card itself has no inner border. -->
        <Border Grid.RowSpan="3" Grid.ColumnSpan="3"
                CornerRadius="12"
                Background="Transparent"
                BorderThickness="0">
            <Grid Margin="6,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title / drag strip with the pin (lock position) button -->
                <Grid x:Name="TitleBar" Background="Transparent"
                      PointerPressed="TitleBar_PointerPressed"
                      PointerMoved="TitleBar_PointerMoved"
                      PointerReleased="TitleBar_PointerReleased"
                      PointerCaptureLost="TitleBar_PointerCaptureLost">
                    <TextBlock Text="ROG 控制" FontSize="12" Foreground="#E8E8EA"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                    <Button x:Name="PinButton"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="PinButton_Click"
                            Background="Transparent" BorderThickness="0"
                            Padding="8,4" Margin="4,0"
                            ToolTipService.ToolTip="固定/解锁位置">
                        <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="12" Foreground="#8A8B90" />
                    </Button>
                </Grid>

                <controls:ROGScreenWidgetContent Grid.Row="1" />
            </Grid>
        </Border>

        <!-- Resize handles: edges (L/R/T/B) and corners (TL/TR/BL/BR),
             transparent, overlaying the outer border, with resize cursors. -->
        <local:ResizeThumb Grid.Row="1" Grid.Column="0" Background="Transparent" Tag="L"
                           CursorShape="SizeWestEast"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
        <local:ResizeThumb Grid.Row="1" Grid.Column="2" Background="Transparent" Tag="R"
                           CursorShape="SizeWestEast"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
        <local:ResizeThumb Grid.Row="0" Grid.Column="1" Background="Transparent" Tag="T"
                           CursorShape="SizeNorthSouth"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
        <local:ResizeThumb Grid.Row="2" Grid.Column="1" Background="Transparent" Tag="B"
                           CursorShape="SizeNorthSouth"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
        <local:ResizeThumb Grid.Row="0" Grid.Column="0" Background="Transparent" Tag="TL"
                           CursorShape="SizeNorthwestSoutheast"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
        <local:ResizeThumb Grid.Row="0" Grid.Column="2" Background="Transparent" Tag="TR"
                           CursorShape="SizeNortheastSouthwest"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
        <local:ResizeThumb Grid.Row="2" Grid.Column="0" Background="Transparent" Tag="BL"
                           CursorShape="SizeNortheastSouthwest"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
        <local:ResizeThumb Grid.Row="2" Grid.Column="2" Background="Transparent" Tag="BR"
                           CursorShape="SizeNorthwestSoutheast"
                           PointerPressed="ResizeThumb_PointerPressed" PointerMoved="ResizeThumb_PointerMoved"
                           PointerReleased="ResizeThumb_PointerReleased" PointerCaptureLost="ResizeThumb_PointerCaptureLost" />
    </Grid>
</Window>
